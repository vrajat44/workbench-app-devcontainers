{
    "name": "WB Data Catalog v2",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "forwardPorts": [8080],
    "postCreateCommand": "cd /app && pip install --no-cache-dir -r requirements.txt && cd /workspace/frontend && npm install",
    "postStartCommand": "cd /app && ./start.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "esbenp.prettier-vscode"
            ]
        }
    }
}
